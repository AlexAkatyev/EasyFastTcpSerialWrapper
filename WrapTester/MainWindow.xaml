<Window x:Class="WrapTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WrapTester"
        mc:Ignorable="d"
        Title="WrapTester"
        Height="450"
        Width="800"
        >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Label
            Grid.Row="0"
            Grid.Column="0"
            Content="Server"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            />
        <CheckBox
            Grid.Row="0"
            Grid.Column="1"
            Content="Client"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Command="{Binding Path=CmdOnClient}"
            />
        <TextBox
            Grid.Row="1"
            Grid.Column="0"
            TextWrapping="Wrap"
            Margin="5 5 5 5"
            Text="{Binding Path=ServerInput}"
            />
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            TextWrapping="Wrap"
            Margin="5 5 5 5"
            Text="{Binding Path=ClientInput}"
            />
        <Grid
            Grid.Row="2"
            Grid.Column="0"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Content="Post"
                Margin="5 5 5 5"
                Command="{Binding Path=CmdServerPost}"
                />
            <Button
                Grid.Column="1"
                Content="Send"
                Margin="5 5 5 5"
                Command="{Binding Path=CmdServerSend}"
                />
            <Button
                Grid.Column="2"
                Content="Send to client"
                Margin="5 5 5 5"
                Command="{Binding Path=CmdServerSendToClient}"
                />
        </Grid>
        <Grid
            Grid.Row="2"
            Grid.Column="1"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Content="Post"
                Margin="5 5 5 5"
                Command="{Binding Path=SendToServer}"
                />
            <Button
                Grid.Column="1"
                Content="Send"
                Margin="5 5 5 5"
                Command="{Binding Path=SendToServer}"
                />
            <Button
                Grid.Column="2"
                Content="Send to server"
                Margin="5 5 5 5"
                Command="{Binding Path=SendToServer}"
                />
        </Grid>
        <TextBox
            Grid.Row="3"
            Grid.Column="0"
            TextWrapping="Wrap"
            Margin="5 5 5 5"
            Text="{Binding Path=ServerOut}"
            />
        <TextBox
            Grid.Row="3"
            Grid.Column="1"
            TextWrapping="Wrap"
            Margin="5 5 5 5"
            Text="{Binding Path=ClientOut}"
            />
    </Grid>
</Window>
